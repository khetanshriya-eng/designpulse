# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# --- Supabase ---
# From your Supabase project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed + fetch scripts to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI summarization ---
# Gemini is tried first, Groq is the fallback. Set both for the fallback
# chain to work; set neither and summarization is skipped.
GEMINI_API_KEY=
GROQ_API_KEY=
# Reserved for future Anthropic swap-in. Not consumed yet.
ANTHROPIC_API_KEY=

# --- Cron secret ---
# A random string. Vercel Cron auto-attaches `Authorization: Bearer <CRON_SECRET>`.
# Must match between Vercel env vars and what /api/cron/* expect.
CRON_SECRET=

# --- Admin alerts (optional but recommended) ---
# Pipeline emails ADMIN_EMAIL on any step failure via Resend
# (https://resend.com — free tier 3,000/mo). If either var is missing the
# alert just logs and no email is sent.
RESEND_API_KEY=
ADMIN_EMAIL=
# Optional: override the From address. Defaults to Resend's onboarding sender,
# which works without domain verification but is more spam-prone.
RESEND_FROM_EMAIL=

# --- Buttondown (legacy newsletter wiring; currently unused) ---
# Kept so the newsletter feature can be re-enabled later without re-keying.
BUTTONDOWN_API_KEY=
